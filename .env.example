# Bind the published web port to loopback by default.
# Change only if access from another machine is intended.
HOST_BIND_IP=127.0.0.1

# Required only when initializing a new, empty database.
INITIAL_ADMIN_PASSWORD=

# Configure the CIDR ranges allowed to unlock from the server side.
ALLOWED_SUBNETS=

# For HTTPS deployments, set COOKIE_SECURE=true.
COOKIE_SECURE=false
VERIFY_SSL=false

# Optional overrides. SECRET_KEY is generated and persisted in data/ when empty.
SECRET_KEY=
VAPID_EMAIL=mailto:admin@example.invalid
WEBHOOK_SECRET=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=2N Access Center
WEBAUTHN_ORIGIN=
